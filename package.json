{
  "name": "subflow",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "dev:web": "turbo run dev --filter=@subflow/web",
    "dev:api": "turbo run dev --filter=@subflow/api",
    "dev:all": "turbo run dev --parallel",
    "seed": "turbo run seed --filter=@subflow/api"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.6.0"
  },
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
