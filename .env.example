# ============================================================
# SubFlow — Environment Variables
# Copy this file to .env and fill in values
# ============================================================

# --- Firebase Configuration ---
# Get these from Firebase Console > Project Settings > General
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# --- Firebase Admin SDK ---
# Download service account key from Firebase Console > Project Settings > Service Accounts
FIREBASE_SERVICE_ACCOUNT_KEY=./firebase-service-account.json
# For local development only. Prefer the Firebase emulator when available.
SUBFLOW_MOCK_FIRESTORE=false
SUBFLOW_ENABLE_MOCK_AUTH=false
INCLUDE_SYNTHETIC_ANALYTICS=false

# --- API Configuration ---
API_PORT=4000
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000/api
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_ENABLE_MOCK_AUTH=false
NEXT_PUBLIC_DEMO_MODE=false

# --- Redis Configuration ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Email Configuration (Nodemailer) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=noreply@subflow.app

# Optional: explains server-calculated analytics without receiving customer identifiers.
GEMINI_API_KEY=
GEMINI_MODEL=

# --- Application ---
NODE_ENV=development
APP_NAME=SubFlow
APP_URL=http://localhost:3000

# --- JWT Secret (for API token signing) ---
JWT_SECRET=your_jwt_secret_here_change_in_production

# --- Rate Limiting ---
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
